# Copy to .env and adjust. On a VM, deploy/install.sh writes this file for you.
# Release to run (deploy/docker-compose.yml); update.sh changes it.
APP_VERSION=v1.0.0
APP_USER=admin
APP_PASSWORD=bitte-ein-langes-passwort-waehlen
PORT=8080
# Time of the daily backup (24h)
BACKUP_TIME=03:00
# Folder on the Docker host where the NAS share is mounted
BACKUP_HOST_DIR=/mnt/nas-finanzen/finanzprognose
# New releases (B-026): auto = install automatically (checked every 15 minutes), notify = only show them in the app
AUTO_UPDATE=auto
