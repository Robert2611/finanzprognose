# Installed by install.sh/update.sh (B-026); @INSTALL_DIR@ is replaced with the install directory.
[Unit]
Description=Finanzprognose: check for a new release and install it
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@INSTALL_DIR@/auto-update.sh
TimeoutStartSec=20min
# docker reads the ghcr.io login from ~/.docker/config.json
Environment=HOME=/root
